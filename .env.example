# Voice Transcriber - Environment Variables Example
# Copy this file to .env and fill in your actual API keys

# Deepgram API Key (required for Deepgram transcription)
# Get your API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (required for OpenAI Whisper transcription)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Google Drive (optional: enables loading audio from your Google Drive) ---
# Create an OAuth "Web application" client in Google Cloud Console, enable the
# Google Drive API, and register your redirect URIs (see CLAUDE.md).
# For local dev the redirect URI is your Streamlit URL, e.g. http://localhost:8501/
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8501/
